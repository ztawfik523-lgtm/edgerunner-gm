# Copy this file to ".env" on your computer or server (never commit .env to git).
# You can leave most values as-is and configure your AI key, Corebook PDF, and accounts in the browser UI.

# Which port you open in your browser (default: 8765)
REDGM_PUBLISH_IP=0.0.0.0
REDGM_HOST_PORT=8765

# Internal container port (leave as 8765 when using default docker-compose port mapping)
REDGM_HOST=0.0.0.0
REDGM_PORT=8765

# Optional: Your public web address if using a domain or reverse proxy (e.g. https://red.example.com)
REDGM_PUBLIC_URL=
REDGM_ALLOWED_ORIGINS=

# Optional: Pre-configure Admin and Player logins here, OR leave blank to create them in the browser on first visit
REDGM_ADMIN_USER=admin
REDGM_ADMIN_PASS=
REDGM_USER_USER=player
REDGM_USER_PASS=

# Required for one-time browser Admin setup when Admin credentials are not preconfigured.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDGM_BOOTSTRAP_TOKEN=

# Optional: Keep sessions valid across container rebuilds (auto-generated in /data/settings.json if left blank)
REDGM_AUTH_SECRET=

# Optional: Simple room passcode for co-op play without named accounts
REDGM_PIN=

# Optional: Set to true to include local CPU AI meaning search (~larger Docker image)
INSTALL_SEMANTIC=false

# Copy to .env on your server (do NOT commit .env to git)

# Host port / publish IP for Docker port mapping
REDGM_PUBLISH_IP=0.0.0.0
REDGM_HOST_PORT=8765

# In-container bind address & port (keep REDGM_PORT=8765 when using default compose port mapping)
REDGM_HOST=0.0.0.0
REDGM_PORT=8765

# Public HTTPS/HTTP URL shown in Co-op join links & allowed origins (optional, e.g. https://red.example.com)
REDGM_PUBLIC_URL=
REDGM_ALLOWED_ORIGINS=

# Optional Admin & Player credentials (or configure them interactively on first visit in the browser)
REDGM_ADMIN_USER=admin
REDGM_ADMIN_PASS=
REDGM_USER_USER=player
REDGM_USER_PASS=

# Optional static HMAC signing secret (auto-generated and saved in /data/settings.json if empty)
REDGM_AUTH_SECRET=

# Optional legacy room PIN if you want PIN-only co-op without named accounts
REDGM_PIN=

# Set to true to include FastEmbed/ONNX local semantic embeddings (~larger image, ARM64 & AMD64 supported)
INSTALL_SEMANTIC=false
